# ==============================================================================
# IEEE ECU Student Branch — Recruitment & Interview Platform
# Root Environment Template
# ==============================================================================

# Supabase Postgres & Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Admin Authentication
JWT_SECRET=your-secure-random-jwt-secret-string-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password

# Email Delivery (Resend or SMTP)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=IEEE ECU Student Branch <onboarding@resend.dev>

# Optional SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=IEEE ECU SB <ieeesb.ecu@gmail.com>

# Application URLs
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_APPLICANT_URL=http://localhost:3000
